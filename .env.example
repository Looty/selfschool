# Copy to .env. Everything has a default; override only what you need.

# --- api (container) ---
# Published on localhost only; the host-side runner connects here.
API_PORT=3001
# SQLite file inside the api container (named volume `selfschool-data`).
SELFSCHOOL_DB=/data/selfschool.db
# Folder with your courses (the selfschool-courses repo), mounted into the api container.
# Default: ../selfschool-courses. Without Docker, set SELFSCHOOL_COURSES_DIR to the same folder.
COURSES_PATH=../selfschool-courses

# --- web (container) ---
WEB_PORT=5174

# --- runner / cli (host) ---
SELFSCHOOL_API_URL=http://127.0.0.1:3001
# Claude adapter. Leave SELFSCHOOL_CLAUDE_BIN empty to use `claude` from PATH.
SELFSCHOOL_CLAUDE_BIN=
# Cheap model for chat and short grading, stronger one for generate/verify.
SELFSCHOOL_MODEL_FAST=haiku
SELFSCHOOL_MODEL_STRONG=sonnet
# Per-call timeout for the AI CLI, in milliseconds.
SELFSCHOOL_JOB_TIMEOUT_MS=180000
