{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-mock",
      "runtimeExecutable": "corepack",
      "runtimeArgs": ["pnpm", "--filter", "@selfschool/web", "dev:mock", "--port", "5174"],
      "port": 5174
    },
    {
      "name": "local",
      "runtimeExecutable": "corepack",
      "runtimeArgs": ["pnpm", "--filter", "@selfschool/local", "dev"],
      "port": 5175
    },
    {
      "name": "local-pages",
      "runtimeExecutable": "corepack",
      "runtimeArgs": ["pnpm", "--filter", "@selfschool/local", "exec", "vite", "preview", "--outDir", "node_modules/.pages", "--base", "/selfschool/", "--port", "5176", "--strictPort"],
      "port": 5176
    }
  ]
}
